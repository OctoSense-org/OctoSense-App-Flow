#!/usr/bin/env python3
"""octo: build, run, capture and check an OctoSense script app.

A thin wrapper over the two real tools, `card-host` and `hub`, which are built
from OctoSense-App-Hub. It never decides admission itself: `octo check` prints
exactly what `hub check` prints and exits with its status.

    tools/octo doctor
    tools/octo new <dir> --platform PLATFORM [--id ID] [--name NAME]
    tools/octo run <bundle> [--port N] [--hidden] [--system] [--detach] [--no-stamp] [--app-data DIR]
    tools/octo shot <port> <out.png>
    tools/octo check <bundle> [hub check flags ...]
    tools/octo publish-github <app-directory> [--replace]
    tools/octo package-help
    tools/octo wasm new <name> [--app DIR] [--sdk auto|git|path]
    tools/octo wasm build [--app DIR] [--crate DIR ...]
    tools/octo wasm doctor [--crate DIR ...]
    tools/octo wasm info <file.wasm> [--json]

Binaries are found, in order, from $OCTO_HUB / $OCTO_CARD_HOST, then
$OCTOSENSE_APP_HUB/target/release, $CARGO_TARGET_DIR/release,
$OCTOSENSE_APP_HUB/../target/release, ../OctoSense-App-Hub/target/release and
../target/release beside this repository, then PATH. `octo wasm` needs cargo
and the wasm32-wasip2 target, and reads WebAssembly with
tools/wasm_component.py. Python 3.9+, no third-party packages.
"""
import argparse
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import textwrap
import time
import urllib.error
